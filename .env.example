# Copy to .env (git-ignored) before `npm run dev` / `npm run dist:*`.
#
# Antigravity signs in through Google's installed-app OAuth flow using the
# client that ships inside the Antigravity desktop binary. Those values are not
# ours to publish, so they are injected at build time instead of committed.
# Leave them empty and Antigravity OAuth is simply disabled — you can still add
# an Antigravity account by pasting a refresh_token or ~/.gemini/oauth_creds.json
# under the "Token / JSON" tab.
HELM_ANTIGRAVITY_CLIENT_ID=
HELM_ANTIGRAVITY_CLIENT_SECRET=
